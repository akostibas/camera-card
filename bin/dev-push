#!/bin/sh
# Put the committed card on the Home Assistant host as a release candidate: tag vX.Y.Z-rcN, push the tag,
# and have the deploy repo install it. /local is cached for a month, so every test build needs its own URL.
# Usage: bin/dev-push [vX.Y.Z]   (default: the next minor after the latest release)
# The next routine deploy puts the host back on its committed pin.
# Public repo: where to deploy lives in .dev-push.env (gitignored), never in this file.
set -eu
cd "$(dirname "$0")/.."
[ -f .dev-push.env ] && . ./.dev-push.env
: "${INFRA_DIR:?dev-push: put INFRA_DIR=<checkout of the repo that deploys the card> in .dev-push.env}"
: "${HA_HOST:?dev-push: put HA_HOST=<name the deploy repo knows the Home Assistant host by> in .dev-push.env}"

if ! git diff --quiet HEAD; then echo "dev-push: uncommitted changes; commit them first (the RC is built from a tag)" >&2; exit 1; fi
[ -d "$INFRA_DIR" ] || { echo "dev-push: no checkout at INFRA_DIR=$INFRA_DIR (fix .dev-push.env)" >&2; exit 1; }
node --check card/camera-card.js

git fetch -q --tags origin
base=${1:-$(git tag -l 'v*' | grep -v -- -rc | sort -V | tail -1 | awk -F. '{print $1 "." $2+1 ".0"}')}
tag=$(git tag -l "$base-rc*" --points-at HEAD | sort -V | tail -1)
if [ -n "$tag" ]; then
  echo "branch $(git branch --show-current) @ $(git rev-parse --short HEAD) is already $tag: installing it again"
else
  tag=$base-rc$(( $(git tag -l "$base-rc*" | wc -l) + 1 ))
  echo "branch $(git branch --show-current) @ $(git rev-parse --short HEAD) -> $tag"
  git tag -a "$tag" -m "Release candidate $tag"
fi
git push -q origin "$tag"
cd "$INFRA_DIR"
# mise: the deploy repo pins its own Go, and the current infra build lives under that toolchain
mise exec -- infra apply ansible --host "$HA_HOST" --tags camera-card --yes -- -e camera_card_version="$tag"
echo "$HA_HOST now serves $tag; Home Assistant restarts (~1 min), then reload the dashboard"
