#!/bin/sh
# Put the committed card on cherry as a release candidate: tag vX.Y.Z-rcN, push the tag, and have
# family-infra install it. cherry's /local is cached for a month, so every test build needs its own URL.
# Usage: bin/dev-push [vX.Y.Z]   (default: the next minor after the latest release)
# The next routine family-infra apply puts cherry back on its committed pin.
set -eu
cd "$(dirname "$0")/.."
infra_dir=${FAMILY_INFRA:-$HOME/LocalDocs/family-infra}

if ! git diff --quiet HEAD; then echo "dev-push: uncommitted changes; commit them first (the RC is built from a tag)" >&2; exit 1; fi
[ -d "$infra_dir" ] || { echo "dev-push: no family-infra checkout at $infra_dir (set FAMILY_INFRA)" >&2; exit 1; }
node --check card/camera-card.js

git fetch -q --tags origin
base=${1:-$(git tag -l 'v*' | grep -v -- -rc | sort -V | tail -1 | awk -F. '{print $1 "." $2+1 ".0"}')}
tag=$(git tag -l "$base-rc*" --points-at HEAD | sort -V | tail -1)
if [ -n "$tag" ]; then
  echo "branch $(git branch --show-current) @ $(git rev-parse --short HEAD) is already $tag: installing it again"
else
  tag=$base-rc$(( $(git tag -l "$base-rc*" | wc -l) + 1 ))
  echo "branch $(git branch --show-current) @ $(git rev-parse --short HEAD) -> $tag"
  git tag -a "$tag" -m "Release candidate $tag"
fi
git push -q origin "$tag"
cd "$infra_dir"
# mise: family-infra pins its own Go, and the current infra build lives under that toolchain
mise exec -- infra apply ansible --host cherry --tags camera-card --yes -- -e camera_card_version="$tag"
echo "cherry now serves $tag; Home Assistant restarts (~1 min), then reload the dashboard"
