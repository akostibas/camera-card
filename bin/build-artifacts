#!/bin/sh
# Inlines harness.js into each prototype so it can be published as a standalone artifact.
set -eu
cd "$(dirname "$0")/.."
mkdir -p dist
for f in proto/*.html; do
  python3 - "$f" "dist/$(basename "$f")" <<'PY'
import sys
src, dst = sys.argv[1:]
html = open(src).read()
tag = '<script src="harness.js"></script>'
assert tag in html, f'{src}: no harness tag'
import re
# The artifact host supplies the document shell, and reads the title only from the first 8KB.
title = re.search(r'<title>.*?</title>', html).group(0)
html = re.sub(r'<!doctype html>|</?html[^>]*>|</?head>|</?body>|<meta [^>]*>|<title>.*?</title>', '', html, flags=re.I)
html = html.replace(tag, '<script>\n' + open('proto/harness.js').read() + '</script>')
open(dst, 'w').write(title + '\n' + html.strip() + '\n')
PY
  echo "built dist/$(basename "$f")"
done
